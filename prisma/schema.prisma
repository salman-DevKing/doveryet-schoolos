// ============================================
// DOVERYET SCHOOLOS — Prisma Schema (v2)
// Multi-tenant: shared DB, schoolId discriminator
// All tables needed for Milestones 1–6
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")   // Hostinger MySQL — mysql://user:pass@host:3306/dbname
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  ACCOUNTANT
}

enum SubscriptionPlan {
  MINI
  STARTER
  GROWTH
  INSTITUTION
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
  UNKNOWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  CREDIT_NOTE
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  CASH
  CHEQUE
  BANK_TRANSFER
  WALLET
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentCollectionMode {
  UPI_ONLY
  BOTH
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StudentLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum NotificationType {
  HOMEWORK_POSTED
  ACTIVITY_POSTED
  FEE_DUE
  FEE_PAID
  LEAVE_DECIDED
  MESSAGE_NEW
  CERTIFICATE_ISSUED
  ATTENDANCE_MARKED
  ANNOUNCEMENT
}

enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_SCHOOL
  RESOLVED
  CLOSED
}

enum OnboardingStage {
  SIGNED_UP
  KYC_CONTRACT
  DATA_IMPORT
  TRAINING
  LIVE
}

enum ConversationScope {
  TEACHER       // Parent ↔ assigned teacher
  ACCOUNTS      // Parent ↔ accounts office
  PRINCIPAL     // Parent ↔ principal's office
  ADMIN         // Parent ↔ generic admin
}

enum AudienceScope {
  ALL            // All parents in school
  CLASS          // Specific class
  STUDENTS       // Specific student IDs (many-to-many)
  TEACHERS       // Staff only
}

// ============================================
// PLATFORM
// ============================================

model School {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  city            String?
  state           String?
  country         String   @default("India")
  logoUrl         String?           // Milestone 1 — mandatory on registration
  schoolType      String?           // "Secondary", "K-12", etc.
  board           String?           // "CBSE", "ICSE", "State"
  establishedYear Int?

  // KYC
  gstin           String?
  pan             String?
  phone           String?
  email           String?
  address         String?

  // Lifecycle
  status          SubscriptionStatus @default(TRIAL)
  trialEndsAt     DateTime?
  onboardingStage OnboardingStage    @default(SIGNED_UP)
  onboardedAt     DateTime?
  csmId           String?
  csm             User?              @relation("CsmSchools", fields: [csmId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Children
  subscription       Subscription?
  paymentDetails     SchoolPaymentDetails?
  academicYears      AcademicYear[]
  users              User[]                @relation("SchoolUsers")
  students           Student[]
  classes            Class[]
  subjects           Subject[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  payments           Payment[]
  staff              Staff[]
  leaveApplications  LeaveApplication[]
  studentLeaves      StudentLeaveRequest[]
  payrollRuns        PayrollRun[]
  announcements      Announcement[]
  activities         Activity[]
  homework           Homework[]
  messages           Message[]
  conversations      Conversation[]
  notifications      Notification[]
  certTemplates      CertificateTemplate[]
  certificates       Certificate[]
  doveryetInvoices   DoveryetInvoice[]
  tickets            Ticket[]
  onboardingTasks    OnboardingTask[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([csmId])
}

// Where parents pay fees to — collected at registration Step 4
model SchoolPaymentDetails {
  id                 String                 @id @default(cuid())
  schoolId           String                 @unique
  school             School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Mode
  collectionMode     PaymentCollectionMode  @default(BOTH)

  // UPI
  upiVpa             String                 // e.g. "principal@okaxis"
  upiPhone           String                 // Number linked to UPI, fallback
  upiQrUrl           String?                // Optional uploaded QR image

  // Bank
  bankAccountHolder  String
  bankName           String
  bankBranch         String?
  bankAccountNumber  String                 // Encrypted at rest at DB level ideally
  bankIfsc           String
  bankAccountType    String                 @default("Savings")

  // Razorpay linked account (when school uses Razorpay Route for direct settlement)
  razorpayAccountId  String?
  razorpayVerified   Boolean                @default(false)

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Subscription {
  id                 String             @id @default(cuid())
  schoolId           String             @unique
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan
  billingCycle       BillingCycle       @default(MONTHLY)
  studentCount       Int                @default(0)
  monthlyPricePaise  Int                @default(0)
  pricePerStudentPaise Int              @default(0)
  cycleTotalPaise    Int                @default(0)
  isLaunchOffer      Boolean            @default(false)
  launchOfferLockedUntil DateTime?
  whatsappAllowance  Int                @default(500)
  whatsappUsed       Int                @default(0)
  billingCycleAnchor DateTime
  renewsAt           DateTime
  autoRenew          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([plan])
  @@index([billingCycle])
}

model DoveryetInvoice {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  periodStart   DateTime
  periodEnd     DateTime
  issuedAt      DateTime      @default(now())
  dueAt         DateTime
  subtotal      Int
  gst           Int           @default(0)
  total         Int
  status        InvoiceStatus @default(DRAFT)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  razorpayId    String?
  items         DoveryetInvoiceItem[]
  createdAt     DateTime      @default(now())

  @@index([schoolId, status])
  @@index([dueAt])
}

model DoveryetInvoiceItem {
  id         String          @id @default(cuid())
  invoiceId  String
  invoice    DoveryetInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label      String
  quantity   Int             @default(1)
  unitAmount Int
  amount     Int
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  name          String
  passwordHash  String?
  image         String?
  role          UserRole
  isActive      Boolean   @default(true)
  schoolId      String?
  school        School?   @relation("SchoolUsers", fields: [schoolId], references: [id], onDelete: Cascade)

  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  teacherOf              Class[]              @relation("ClassTeacher")
  staffProfile           Staff?
  parentOf               StudentParentLink[]
  markedAttendance       Attendance[]         @relation("AttendanceMarkedBy")
  authoredAnnouncements  Announcement[]       @relation("AnnouncementAuthor")
  authoredActivities     Activity[]           @relation("ActivityAuthor")
  authoredHomework       Homework[]           @relation("HomeworkAuthor")
  leaveApprovals         LeaveApplication[]   @relation("LeaveApprover")
  studentLeaveDecisions  StudentLeaveRequest[] @relation("StudentLeaveDecider")
  assignedTickets        Ticket[]             @relation("TicketAssignee")
  createdTickets         Ticket[]             @relation("TicketCreator")
  ticketMessages         TicketMessage[]
  csmSchools             School[]             @relation("CsmSchools")
  auditLogs              AuditLog[]
  parentMessages         Message[]            @relation("MessageAuthor")
  conversationsParent    Conversation[]       @relation("ConversationParent")
  conversationsStaff     Conversation[]       @relation("ConversationStaff")
  notifications          Notification[]
  issuedCertificates     Certificate[]        @relation("CertificateIssuer")

  @@index([schoolId, role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// OTP sessions for parent app login
model OtpRequest {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expires   DateTime
  consumedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}

// ============================================
// ACADEMIC
// ============================================

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  classes       Class[]
  feeStructures FeeStructure[]
  invoices      Invoice[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Class {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  grade          Int
  section        String
  name           String
  classTeacherId String?
  classTeacher   User?        @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  students        Student[]
  classSubjects   ClassSubject[]
  attendance      Attendance[]
  homework        Homework[]
  activities      Activity[]

  @@unique([schoolId, academicYearId, grade, section])
  @@index([schoolId])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String

  classSubjects ClassSubject[]
  homework      Homework[]

  @@unique([schoolId, code])
}

model ClassSubject {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?

  @@unique([classId, subjectId])
}

model Student {
  id             String      @id @default(cuid())
  schoolId       String
  school         School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo    String
  firstName      String
  lastName       String?
  dob            DateTime?
  gender         Gender?
  bloodGroup     BloodGroup  @default(UNKNOWN)
  motherTongue   String?
  photoUrl       String?
  classId        String?
  class          Class?      @relation(fields: [classId], references: [id])
  rollNo         Int?
  address        String?
  phone          String?
  email          String?
  isActive       Boolean     @default(true)
  admissionDate  DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  parents             StudentParentLink[]
  attendance          Attendance[]
  invoices            Invoice[]
  leaveRequests       StudentLeaveRequest[]
  certificateIssues   CertificateIssue[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, classId])
}

model StudentParentLink {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation  String
  isPrimary Boolean @default(false)
  @@unique([studentId, parentId])
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())
  @@unique([studentId, date])
  @@index([classId, date])
}

// ============================================
// FEES & INVOICES (to parents, from school)
// ============================================

model FeeStructure {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  grade          Int
  name           String
  items          FeeStructureItem[]
  createdAt      DateTime     @default(now())
  @@unique([schoolId, academicYearId, grade])
}

model FeeStructureItem {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  label          String
  amount         Int
  period         String
  isOptional     Boolean      @default(false)
}

model Invoice {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  invoiceNumber  String
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Int
  discount       Int           @default(0)
  total          Int
  amountPaid     Int           @default(0)
  status         InvoiceStatus @default(DRAFT)
  notes          String?
  items          InvoiceItem[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([dueDate])
}

model InvoiceItem {
  id         String  @id @default(cuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label      String
  period     String?
  quantity   Int     @default(1)
  unitAmount Int
  amount     Int
}

model Payment {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  amount         Int
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  razorpayId     String?       @unique
  razorpayOrderId String?
  upiReferenceId String?       // For manual UPI reconciliation
  reference      String?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  @@index([schoolId, status])
}

// ============================================
// STAFF, LEAVE & PAYROLL
// ============================================

model Staff {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId      String
  designation     String
  department      String?
  joinDate        DateTime
  pan             String?
  uan             String?
  bankAccount     String?
  bankIfsc        String?
  basicSalary     Int
  hra             Int      @default(0)
  da              Int      @default(0)
  conveyance      Int      @default(0)
  specialAllowance Int     @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leaveBalances LeaveBalance[]
  payslips      Payslip[]

  @@unique([schoolId, employeeId])
}

model LeaveApplication {
  id         String      @id @default(cuid())
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId    String
  type       LeaveType
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  days       Float
  reason     String
  status     LeaveStatus @default(PENDING)
  approverId String?
  approver   User?       @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())
  @@index([schoolId, status])
}

model LeaveBalance {
  id      String    @id @default(cuid())
  staffId String
  staff   Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type    LeaveType
  year    Int
  total   Float
  used    Float     @default(0)
  @@unique([staffId, type, year])
}

model PayrollRun {
  id         String        @id @default(cuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  status     PayrollStatus @default(DRAFT)
  totalGross Int           @default(0)
  totalDeductions Int      @default(0)
  totalNet   Int           @default(0)
  runBy      String?
  runAt      DateTime?
  createdAt  DateTime      @default(now())
  payslips Payslip[]
  @@unique([schoolId, year, month])
}

model Payslip {
  id            String     @id @default(cuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staffId       String
  staff         Staff      @relation(fields: [staffId], references: [id])
  paidDays      Float
  gross         Int
  deductions    Int
  net           Int
  items         PayslipItem[]
  createdAt     DateTime   @default(now())
  @@unique([payrollRunId, staffId])
}

model PayslipItem {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  kind      String
  label     String
  amount    Int
}

// ============================================
// COMMUNICATION (Milestone 4)
// ============================================

model Announcement {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String        @db.Text
  authorId    String
  author      User          @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  audience    AudienceScope
  classId     String?       // when audience=CLASS
  publishedAt DateTime      @default(now())
  @@index([schoolId, publishedAt])
}

// Published activities (Sports Day, Science Exhibition, etc.)
model Activity {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String        @db.Text
  authorId    String
  author      User          @relation("ActivityAuthor", fields: [authorId], references: [id])
  audience    AudienceScope
  classId     String?
  class       Class?        @relation(fields: [classId], references: [id])
  activityDate DateTime     @db.Date
  photoUrls   Json          @default("[]")  // string[] stored as JSON (MySQL has no native arrays)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  @@index([schoolId, publishedAt])
  @@index([classId])
}

// Homework assigned to a class
model Homework {
  id              String        @id @default(cuid())
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId         String
  class           Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id])
  authorId        String
  author          User          @relation("HomeworkAuthor", fields: [authorId], references: [id])
  title           String
  description     String        @db.Text
  assignedDate    DateTime      @db.Date @default(now())
  dueDate         DateTime
  attachmentUrls  Json          @default("[]")  // string[] as JSON
  createdAt       DateTime      @default(now())
  @@index([classId, dueDate])
  @@index([schoolId, assignedDate])
}

// Parent-school chat conversations
model Conversation {
  id         String            @id @default(cuid())
  schoolId   String
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId   String
  parent     User              @relation("ConversationParent", fields: [parentId], references: [id])
  staffId    String
  staff      User              @relation("ConversationStaff", fields: [staffId], references: [id])
  scope      ConversationScope
  studentId  String?           // When conversation is about a specific child
  lastMessageAt DateTime       @default(now())
  parentUnreadCount Int        @default(0)
  staffUnreadCount  Int        @default(0)
  createdAt  DateTime          @default(now())
  messages Message[]
  @@index([schoolId, parentId])
  @@index([schoolId, staffId])
  @@index([lastMessageAt])
}

model Message {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation("MessageAuthor", fields: [authorId], references: [id])
  body           String        @db.Text
  attachmentUrls Json          @default("[]")  // string[] as JSON
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  @@index([conversationId, createdAt])
}

// Student leave requested by parent via Parent App
model StudentLeaveRequest {
  id          String              @id @default(cuid())
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromDate    DateTime            @db.Date
  toDate      DateTime            @db.Date
  isHalfDay   Boolean             @default(false)
  reason      String              @db.Text
  status      StudentLeaveStatus  @default(PENDING)
  decidedById String?
  decidedBy   User?               @relation("StudentLeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  responseNote String?            @db.Text
  createdAt   DateTime            @default(now())
  @@index([schoolId, status])
  @@index([studentId, fromDate])
}

// In-app notifications
model Notification {
  id         String            @id @default(cuid())
  schoolId   String
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  routeTo    String?           // deep-link: "/parent/homework/123"
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime          @default(now())
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ============================================
// CERTIFICATES (Milestone 6)
// ============================================

model CertificateTemplate {
  id          String   @id @default(cuid())
  schoolId    String?  // null = built-in template
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug        String   // "classic-formal", "playful-preschool", "bold-competition", "modern-elegant"
  name        String
  category    String   // "Achievement" | "Participation" | "Competition"
  isBuiltIn   Boolean  @default(false)
  config      Json     // Template-specific overrides: colors, fonts, layout
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certificates Certificate[]
  @@unique([schoolId, slug])
}

// A single generated certificate batch (one event, many students)
model Certificate {
  id              String              @id @default(cuid())
  schoolId        String
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id])
  referenceCode   String              // CERT-2026-00284 (shared across the batch's issues if desired)
  eventName       String
  eventDate       DateTime            @db.Date
  issueDate       DateTime            @db.Date @default(now())
  awardText       String?             // "1st Place — 100m Sprint"
  category        String              // Mirror of template.category at issue time
  citation        String              @db.Text
  signatoryName   String
  signatoryRole   String
  signatureUrl    String?
  issuerId        String
  issuer          User                @relation("CertificateIssuer", fields: [issuerId], references: [id])
  createdAt       DateTime            @default(now())

  issues CertificateIssue[]
  @@index([schoolId, issueDate])
}

// One certificate issue per student in the batch
model CertificateIssue {
  id             String      @id @default(cuid())
  certificateId  String
  certificate    Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pdfUrl         String?     // Rendered PDF stored in Blob
  issueCode      String      @unique // Per-student unique code
  createdAt      DateTime    @default(now())
  @@unique([certificateId, studentId])
}

// ============================================
// DOVERYET SUPPORT & ONBOARDING
// ============================================

model Ticket {
  id         String         @id @default(cuid())
  schoolId   String
  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ticketNumber String       @unique
  subject    String
  category   String
  priority   TicketPriority @default(P3)
  status     TicketStatus   @default(OPEN)
  assigneeId String?
  assignee   User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy  User           @relation("TicketCreator", fields: [createdById], references: [id])
  firstResponseAt DateTime?
  resolvedAt DateTime?
  csatScore  Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages TicketMessage[]
  @@index([schoolId, status])
  @@index([assigneeId, status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([ticketId])
}

model OnboardingTask {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stage      OnboardingStage
  title      String
  isComplete Boolean          @default(false)
  completedAt DateTime?
  order      Int              @default(0)
  @@index([schoolId, stage])
}

// ============================================
// AUDIT
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
}
