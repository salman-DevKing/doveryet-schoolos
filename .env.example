# ============================================
# DOVERYET SCHOOLOS — Environment Variables
# Deployment target: Hostinger Web App + Neon Postgres + Cloudflare R2
# ============================================

# ===== Database (Hostinger MySQL — included with your plan) =====
# Create in hPanel → Databases → MySQL Databases
#   Format: mysql://<user>:<pass>@<host>:3306/<database>
#   On same Hostinger server: host = "localhost" (fastest, no network hop)
#   For external tools (local dev, DB admin): use "Remote MySQL" and whitelist the IP;
#   host becomes the one shown next to your DB (e.g. "mysql.hostinger.com" or an IP)
DATABASE_URL="mysql://u123456789_schoolos:STRONG_PASSWORD@localhost:3306/u123456789_schoolos"

# ===== Auth.js (NextAuth v5) =====
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://schoolos.doveryet.com"
# Only needed on Hostinger if auto-detection fails:
AUTH_TRUST_HOST="true"

# ===== Public URL (used in emails, deep links) =====
NEXT_PUBLIC_APP_NAME="Doveryet SchoolOS"
NEXT_PUBLIC_APP_URL="https://schoolos.doveryet.com"

# ===== File storage (Cloudflare R2 — free tier 10 GB) =====
STORAGE_PROVIDER="r2"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="schoolos-assets"
# Set this after enabling R2 Public Access (bucket settings → "Allow public access")
# OR after you attach a custom domain like assets.doveryet.com via Cloudflare
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# ===== Razorpay (payments) =====
# Create at razorpay.com — use rzp_test_* keys until Live mode is activated (3-7 days KYC)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ===== Email (SMTP — use Zoho Mail with your doveryet.com domain) =====
# Zoho free: 5 users, use smtp.zoho.in:587 with app-specific password
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="587"
SMTP_USER="no-reply@doveryet.com"
SMTP_PASS=""
SMTP_FROM="SchoolOS <no-reply@doveryet.com>"

# ===== SMS OTP (Milestone 3 — parent app login) =====
# MSG91 or Twilio. Leave blank until needed.
SMS_PROVIDER="msg91"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="DOVRYT"
MSG91_OTP_TEMPLATE_ID=""

# ===== Error tracking (optional but recommended) =====
SENTRY_DSN=""
